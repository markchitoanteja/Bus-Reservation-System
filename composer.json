{
  "name": "codeigniter4/appstarter",
  "type": "project",
  "require": {
    "php": "^7.3 || ^8.0",
    "codeigniter4/framework": "^4.4",
    "ramsey/uuid": "^4.8"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-update-cmd": [
      "@composer dump-autoload"
    ],
    "post-install-cmd": [
      "@composer dump-autoload"
    ]
  }
}
